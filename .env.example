# BankSSL Tracker Configuration

# Database connection URL (SQLite by default)
DATABASE_URL="sqlite:///./bankssl.db"

# Timeout in seconds for SSL/TLS handshakes and connections
CHECK_TIMEOUT="10"

# Server host and port for local execution
HOST="127.0.0.1"
PORT="8000"

# Concurrency thread pool size for "Check All"
MAX_WORKERS="10"
